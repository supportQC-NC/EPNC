# =============================================================================
# exemple.env — copier en `.env` à la racine, puis remplir.
# Ce fichier est versionné ; `.env` ne l'est pas (voir .gitignore).
#
# ⚠️ Leçon tirée de QC_tools : son exemple.env documentait 15 variables alors
#    que le backend en lisait 33. Toute variable lue par le code DOIT figurer
#    ici, même vide. Mettre les deux à jour dans le même commit.
# =============================================================================

# --- Base ---------------------------------------------------------------
# development | production. Pilote aussi le flag `secure` du cookie JWT
# (secure=false uniquement en "development") et l'affichage de la stack trace.
NODE_ENV=development
PORT=5000

# URI MongoDB. Local : mongodb://127.0.0.1:27017/hackavp
# Atlas : mongodb+srv://<user>:<password>@<cluster>/hackavp?retryWrites=true&w=majority
MONGO_URI=

# Secret de signature des JWT. Chaîne longue et aléatoire.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Front / CORS -------------------------------------------------------
# Origine autorisée par CORS ET base des liens envoyés par email
# (lien de réinitialisation de mot de passe). Sans slash final.
FRONTEND_URL=http://localhost:3000

# Production uniquement : chemin absolu du build CRA servi par Express.
# Laisser vide en développement.
FRONTEND_BUILD_PATH=

# --- Email (mot de passe oublié) ----------------------------------------
# Tant que SMTP_HOST est vide, l'envoi est désactivé : le lien de
# réinitialisation est écrit dans la console du serveur. Pratique en dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Emploi Public NC

# --- Envoi des candidatures (fonction ④) --------------------------------
# 🔴 ADRESSE DE TEST, ET RIEN D'AUTRE.
#
# Toute candidature produite par l'application part À CETTE ADRESSE, jamais à
# celle qui figure dans l'offre. Les fiches de poste contiennent de VRAIES
# adresses de recrutement (DRH-candidature@opt.nc côté OPT-NC,
# drhfpnc.recrutement@gouv.nc et des adresses nominatives d'agents côté
# data.gouv.nc) : une candidature de démonstration qui y parviendrait ferait
# perdre son temps à une personne réelle.
#
# Le code refuse d'envoyer vers tout domaine en opt.nc, gouv.nc ou drhfpnc.nc,
# même si l'adresse est saisie ici. Mettez une boîte qui vous appartient.
#
# Vide = envoi impossible (c'est volontaire). Le téléchargement du dossier ZIP
# et des PDF, lui, fonctionne sans cette variable.
CANDIDATURE_EMAIL_TEST=

# --- Source des offres (npm run data:avps) ------------------------------
# Dataset public Hugging Face, point d'entrée recommandé par l'OPT-NC.
# Changer cette URL suffit à brancher une autre source JSONL de JobPosting.
AVP_DATASET_URL=https://huggingface.co/datasets/opt-nc/odata-avps/resolve/main/data/all_avps.jsonl

# --- Rédaction assistée (pas encore branchée) ---------------------------
# Prévu pour la production des pièces de candidature. Tant que la clé est vide,
# backend/services/redactionService.js assemble des brouillons à partir du
# profil et de la fiche de poste, sans appel à un modèle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Passe de critique : la lettre et le CV sont relus par le modèle « en
# recruteur », notés sur 10, et réécrits sous ce seuil. La version réécrite
# n'est conservée que si elle note mieux que la première.
#   7  = défaut
#   10 = réécriture systématique (utile pour comparer les deux jets)
#   0  = critique désactivée
CRITIQUE_SEUIL=7

# --- Inscription publique -----------------------------------------------
# true  : n'importe qui peut créer un compte candidat (POST /api/users/register)
# false : création de comptes réservée aux admins
ALLOW_PUBLIC_REGISTER=true

# --- Compte administrateur initial (npm run data:import) ----------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOM=
SEED_ADMIN_PRENOM=
